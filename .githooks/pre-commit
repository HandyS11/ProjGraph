#!/bin/sh
# Pre-commit hook: run dotnet format on staged .cs files
# Install: git config core.hooksPath .githooks

STAGED_CS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs')

if [ -z "$STAGED_CS_FILES" ]; then
  exit 0
fi

echo "Running dotnet format on staged C# files..."
dotnet format ProjGraph.slnx --no-restore --include $STAGED_CS_FILES

# Re-stage any files that were reformatted
for file in $STAGED_CS_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

# Verify no remaining issues
dotnet format ProjGraph.slnx --no-restore --verify-no-changes --include $STAGED_CS_FILES
if [ $? -ne 0 ]; then
  echo "Error: dotnet format could not fully resolve formatting issues."
  echo "Please fix manually and try again."
  exit 1
fi

exit 0
