<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- Package configuration -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>projgraph</ToolCommandName>

    <!-- Package metadata -->
    <PackageId>ProjGraph.Cli</PackageId>
    <Title>ProjGraph CLI</Title>
    <PackageIcon>icon.png</PackageIcon>
    <Description>CLI tool to visualize project dependencies and generate graphs.</Description>
    <PackageTags>dotnet-tool;graph;dependencies;visualization;erd;classdiagram;mermaid;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Expose internals to test projects -->
  <ItemGroup>
    <InternalsVisibleTo Include="ProjGraph.Tests.Integration.Cli"/>
  </ItemGroup>

  <!-- Include README and icon in package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/"/>
    <None Include="..\..\icon.png" Pack="true" PackagePath=""/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjGraph.Lib\ProjGraph.Lib.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Spectre.Console.Cli"/>
  </ItemGroup>

</Project>
