{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/tests/**"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/*.yml"]
      },
      {
        "files": [
          "index.md",
          "license.md",
          "toc.yml",
          "guides/toc.yml",
          "dev/toc.yml"
        ]
      },
      {
        "src": "..",
        "files": [
          "README.md",
          "ARCHITECTURE.md",
          "CONTRIBUTING.md",
          "SECURITY.md",
          "src/ProjGraph.Cli/README.md",
          "src/ProjGraph.Mcp/README.md",
          "src/ProjGraph.Lib/README.md",
          "src/ProjGraph.Lib.Core/README.md",
          "src/ProjGraph.Lib.ClassDiagram/README.md",
          "src/ProjGraph.Lib.EntityFramework/README.md",
          "src/ProjGraph.Lib.Dependencies/README.md",
          "src/ProjGraph.Core/README.md",
          "samples/**/*.md",
          "specs/**/*.md"
        ]
      }
    ],
    "resource": [
      {
        "src": "..",
        "files": [
          "LICENSE",
          "specs/**/*.json",
          "samples/**/*.json",
          "samples/**/*.mmd",
          "icon.png"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "ProjGraph",
      "_appFooter": "Made with DocFX.",
      "_enableSearch": true,
      "_appFaviconPath": "icon.png",
      "pdf": false
    }
  }
}
